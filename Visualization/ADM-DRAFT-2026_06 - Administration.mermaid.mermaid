  ADM-001-008["<i>ADM-001-008</i><br><b>[M] Journaliser<br>basiquement l&#39;utilisation<br>des comptes<br>d&#39;administration</b>"]
  ADM-001-009["<i>ADM-001-009</i><br><b>[M] Utiliser des comptes<br>individuels pour<br>l&#39;administration</b>"]
  ADM-001-010["<i>ADM-001-010</i><br><b>[M] Utiliser des comptes et<br>mots de passe uniques<br>pour les comptes<br>d&#39;administration &quot;locaux&quot;<br>sur les systèmes</b>"]
  ADM-001-011["<i>ADM-001-011</i><br><b>[M] Mettre entre œuvre une<br>authentification à deux<br>facteurs avec jeton<br>d&#39;authentification<br>physique</b>"]
  ADM-001-012["<i>ADM-001-012</i><br><b>[M] Mettre en œuvre une<br>gestion centralisée des<br>comptes d&#39;administration</b>"]
  ADM-001-013["<i>ADM-001-013</i><br><b>[M] Limiter les droits des<br>administrateurs aux<br>seules actions qu&#39;ils ont<br>besoin de réaliser</b>"]
  ADM-001-014["<i>ADM-001-014</i><br><b>[M] Éviter l&#39;identification<br>explicite des comptes<br>d&#39;administration</b>"]
  ADM-001-015["<i>ADM-001-015</i><br><b>[M] Mettre en œuvre une<br>architecture de type<br>&quot;Zero Trust&quot; pour les<br>accès d&#39;administration<br>des systèmes</b>"]
  ADM-001-016["<i>ADM-001-016</i><br><b>[M] Journaliser finement<br>l&#39;utilisation des comptes<br>d&#39;administration</b>"]
  ADM-001-017["<i>ADM-001-017</i><br><b>[M] Distinguer les comptes<br>des rôles<br>d&#39;administration des<br>autres rôles</b>"]
  ADM-001-018["<i>ADM-001-018</i><br><b>[M] Tenir à jour la liste des<br>comptes d&#39;administration</b>"]
  ADM-001-019["<i>ADM-001-019</i><br><b>[M] Désactiver ou supprimer<br>les comptes<br>d&#39;administration expirés.<br>
Avoir une stratégie de<br>cycle de vie des comptes<br>d&#39;administration</b>"]
  ADM-001-020["<i>ADM-001-020</i><br><b>[M] Utiliser des protocoles<br>sécurisés</b>"]
  ADM-001-021["<i>ADM-001-021</i><br><b>[M] Chiffrer les données en<br>transit</b>"]
  ADM-001-022["<i>ADM-001-022</i><br><b>[M] Chiffrer les données au<br>repos</b>"]
  ADM-001-023["<i>ADM-001-023</i><br><b>[M] Chiffrer les sauvegardes</b>"]
  ADM-001-024["<i>ADM-001-024</i><br><b>[M] Utiliser des versions de<br>systèmes d&#39;exploitation<br>(OS) supportées</b>"]
  ADM-001-025["<i>ADM-001-025</i><br><b>[M] Supprimer des postes<br>d&#39;administration (dédié<br>ou non) les élements non<br>indispensable à<br>l&#39;administration </b>"]
  ADM-001-026["<i>ADM-001-026</i><br><b>[M] Durcir le système du<br>terminal utilisé pour les<br>taches d&#39;administration</b>"]
  ADM-001-027["<i>ADM-001-027</i><br><b>[M] Durcir les navigateurs du<br>terminal utilisé pour les<br>tâches d&#39;administration</b>"]
  ADM-001-028["<i>ADM-001-028</i><br><b>[M] Mettre en œuvre un<br>antivirus sur les<br>terminaux<br>d&#39;administration</b>"]
  ADM-001-029["<i>ADM-001-029</i><br><b>[M] Configurer un service DNS<br>filtrant</b>"]
  ADM-001-030["<i>ADM-001-030</i><br><b>[M] Activer le pare-feu local<br>sur les terminaux<br>d&#39;administration</b>"]
  ADM-001-031["<i>ADM-001-031</i><br><b>[M] Mettre en œuvre un EDR<br>sur les terminaux<br>d&#39;administration</b>"]
  ADM-001-032["<i>ADM-001-032</i><br><b>[M] Mettre en œuvre un SI<br>d&#39;administration<br>intermédiaire dédié entre<br>les terminaux et le SI de<br>production</b>"]
  ADM-001-033["<i>ADM-001-033</i><br><b>[M] Mettre en œuvre un rebond<br>en intermédiaire entre<br>les terminaux<br>d&#39;administration et le SI<br>administré</b>"]
  ADM-001-034["<i>ADM-001-034</i><br><b>[M] Limiter l&#39;exposition du<br>serveurs de rebond à un<br>tunnel VPN</b>"]
  ADM-001-035["<i>ADM-001-035</i><br><b>[M] Mettre en œuvre des<br>postes maitrisés par<br>l&#39;entité</b>"]
  ADM-001-036["<i>ADM-001-036</i><br><b>[M] Mettre en œuvre un<br>environnement logiciel<br>dédié aux actions<br>d&#39;administration sur un<br>poste usuel</b>"]
  ADM-001-037["<i>ADM-001-037</i><br><b>[M] Mettre en œuvre une<br>machine virtuelle sur un<br>poste usuel pour les<br>actions d&#39;administration</b>"]
  ADM-001-038["<i>ADM-001-038</i><br><b>[M] Mettre en œuvre un<br>terminal dédié aux seules<br>actions d&#39;administration</b>"]
  ADM-001-039["<i>ADM-001-039</i><br><b>[M] Mettre en œuvre une<br>machine virtuelle sur un<br>poste d&#39;administration<br>pour les actions de<br>bureautique</b>"]
  ADM-001-040["<i>ADM-001-040</i><br><b>[M] Mettre en œuvre un double<br>amorçage avec chiffrement<br>des disques sur les<br>terminaux pour cloisonner<br>le système pour<br>l&#39;administration des<br>autres systèmes usuels</b>"]
  ADM-001-041["<i>ADM-001-041</i><br><b>[M] Mettre en œuvre un<br>filtrage périmètrique sur<br>le système d&#39;information<br>d&#39;administration</b>"]
  ADM-001-042["<i>ADM-001-042</i><br><b>[M] Mettre en œuvre un<br>filtrage sur l&#39;ensemble<br>du système d&#39;information<br>d&#39;administration et entre<br>ses composants</b>"]
  ADM-001-043["<i>ADM-001-043</i><br><b>[M] Mettre à jour les<br>systèmes liés à<br>l&#39;activité<br>d&#39;administration les plus<br>simples à mettre à jour</b>"]
  ADM-001-044["<i>ADM-001-044</i><br><b>[M] Activer les mises à jour<br>automatiques </b>"]
  ADM-001-045["<i>ADM-001-045</i><br><b>[M] Suivre les alertes de<br>sécurité du CERT-FR</b>"]
  ADM-001-046["<i>ADM-001-046</i><br><b>[M] Mettre à jour les outils<br>liés à l&#39;activité<br>d&#39;administration les plus<br>critiques</b>"]
  ADM-001-047["<i>ADM-001-047</i><br><b>[M] Mettre à jour les<br>systèmes liés à<br>l&#39;activité<br>d&#39;administration les plus<br>exposés</b>"]
  ADM-001-048["<i>ADM-001-048</i><br><b>[M] Vérifier l&#39;authenticité<br>des données entrantes</b>"]
  ADM-001-049["<i>ADM-001-049</i><br><b>[M] Vérifier l&#39;intégrité des<br>données entrantes</b>"]
  ADM-001-050["<i>ADM-001-050</i><br><b>[M] Analyser les données<br>entrantes</b>"]
  ADM-001-051["<i>ADM-001-051</i><br><b>[M] Valider l&#39;innocuité des<br>entrants sur un système<br>cloisonné</b>"]
