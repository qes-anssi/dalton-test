classDef MesureMoins font-size:16px,fill:#E0E3E6,stroke:#284370,color:#284370
classDef Recommendation font-size:16px,fill:#E0E3E6,stroke:#284370,color:#284370

  ADM-001-001["<i>ADM-001-001</i><br><b>[M] Protéger les comptes<br>d&#39;administration avec un<br>mot de passe</b>"]
  ADM-001-002["<i>ADM-001-002</i><br><b>[M] Supprimer/remplacer les<br>comptes par défaut sur<br>les systèmes et outils<br>d&#39;administration</b>"]
  ADM-001-003["<i>ADM-001-003</i><br><b>[M] Mettre en œuvre un<br>gestionnaire de mots de<br>passe pour les comptes<br>d&#39;administration</b>"]
  ADM-001-004["<i>ADM-001-004</i><br><b>[M] Mettre entre œuvre une<br>authentification à deux<br>facteurs</b>"]
